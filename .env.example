# ---------------------------------------------------------------------------
# LEO JEWELS frontend configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Base URL of the Java Spring Boot REST API, e.g. https://api.leojewels.example/api
# Leave blank to run the frontend in clearly-labelled demo mode.
VITE_API_BASE_URL=

# Public Razorpay key id (safe to expose). Checkout still requires a backend to
# create the order and verify the signature server-side.
VITE_RAZORPAY_KEY_ID=

# Currency + storefront metadata
VITE_CURRENCY=INR
VITE_STORE_NAME=LEO JEWELS
